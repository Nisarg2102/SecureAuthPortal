@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model SecureAuthPortal.ViewModels.ResetPasswordViewModel

<style>

    
    .login-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 20px;
    }
    
    .login-card {
        background: rgba(255,255,255,0.94);
        backdrop-filter: blur(8px);
        border: none;
        border-radius: 25px;
        box-shadow: 0px 20px 60px rgba(0,0,0,0.4);
        overflow: hidden;
        max-width: 450px;
        width: 100%;
    }
    
    .login-header {
        background: linear-gradient(
            135deg,
            #183B56,
            #285072,
            #4C7190
        );
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .login-header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(
            45deg,
            transparent,
            rgba(255,255,255,0.1),
            transparent
        );
        animation: shine 3s infinite;
    }
    
    @@keyframes shine {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .login-header h2 {
        margin: 0;
        font-weight: 700;
        font-size: 32px;
        text-shadow: 0 2px 15px rgba(0,0,0,0.3);
        position: relative;
        z-index: 1;
    }
    
    .login-header p {
        margin: 10px 0 0 0;
        opacity: 0.95;
        font-size: 15px;
        position: relative;
        z-index: 1;
    }
    
    .login-body {
        padding: 35px 30px;
        background: rgba(255,255,255,0.98);
    }
    
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        font-size: 14px;
    }
    
    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s;
        font-size: 15px;
        background: white;
    }
    
    .form-control:focus {
        border-color: #4C7190;
        box-shadow: 0px 0px 10px rgba(76,113,144,0.25);
        background: linear-gradient(to right, #ffffff, #f0f8ff);
    }
    
    .btn-login {
        background: linear-gradient(
            135deg,
            #183B56,
            #285072
        );
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        color: white;
        width: 100%;
        transition: all 0.3s;
        font-size: 16px;
        box-shadow: 0 5px 20px rgba(24,59,86,0.35);
        position: relative;
        overflow: hidden;
    }
    
    .btn-login::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }
    
    .btn-login:hover::before {
        left: 100%;
    }
    
    .btn-login:hover {
        background: linear-gradient(
            135deg,
            #285072,
            #4C7190
        );
        transform: translateY(-2px);
        box-shadow: 0px 8px 20px rgba(24,59,86,0.35);
    }
    
    .register-link {
        text-align: center;
        margin-top: 20px;
        color: #333;
        font-size: 14px;
    }
    
    .register-link a {
        color: #285072;
        font-weight: 600;
        text-decoration: none;
        background: linear-gradient(135deg, #183B56, #4C7190);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .register-link a:hover {
        text-decoration: underline;
    }
    
    .alert {
        border-radius: 10px;
        font-size: 14px;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <h2>Reset Password</h2>
            <p>Enter your new password below</p>
        </div>
        
        <div class="login-body">
            @if(TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""] is { Errors.Count: > 0 } modelStateErrors)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @foreach (var error in modelStateErrors.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="ResetPassword" method="post">

                <div class="mb-4">
                    <label class="form-label">New Password</label>
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-login mb-3">
                    Reset Password
                </button>

                <div class="register-link">
                    Cancel and <a asp-action="Login">go back to Login</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
