@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ===== ENTRANCE ANIMATION ===== */
    .dashboard-card {
        background: rgba(255,255,255,0.94);
        backdrop-filter: blur(8px);
        border: none;
        border-radius: 25px;
        box-shadow: 0px 20px 60px rgba(0,0,0,0.4);
        padding: 40px;
        margin-bottom: 24px;
        animation: fadeSlideUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }

    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(32px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .dashboard-card h2 {
        color: #183B56;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .dashboard-card h4 {
        color: #285072;
        font-weight: 500;
        margin: 20px 0 24px;
    }

    /* ===== STAT CARDS ===== */
    .stat-mini {
        background: rgba(255,255,255,0.96);
        backdrop-filter: blur(8px);
        border-radius: 20px;
        padding: 22px 24px;
        box-shadow: 0 8px 28px rgba(0,0,0,0.15);
        display: flex;
        align-items: center;
        gap: 18px;
        animation: fadeSlideUp 0.6s cubic-bezier(0.22,1,0.36,1) both;
        transition: transform 0.25s, box-shadow 0.25s;
        margin-bottom: 20px;
    }

    .stat-mini:hover {
        transform: translateY(-5px);
        box-shadow: 0 16px 40px rgba(0,0,0,0.22);
    }

    .stat-mini:nth-child(2) { animation-delay: 0.08s; }
    .stat-mini:nth-child(3) { animation-delay: 0.16s; }

    .stat-icon-circle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-mini .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #183B56;
        line-height: 1;
    }

    .stat-mini .stat-title {
        font-size: 13px;
        color: #888;
        font-weight: 500;
        margin-top: 4px;
    }

    /* ===== BUTTONS ===== */
    .btn-primary {
        background: linear-gradient(135deg, #183B56, #285072);
        border: none;
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 5px 20px rgba(24,59,86,0.35);
    }

    .btn-primary:hover {
        background: linear-gradient(135deg, #285072, #4C7190);
        transform: translateY(-2px);
        box-shadow: 0px 8px 20px rgba(24,59,86,0.35);
    }

    .welcome-badge {
        display: inline-block;
        background: linear-gradient(135deg, #183B56, #4C7190);
        color: white;
        border-radius: 50px;
        padding: 4px 18px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 12px;
        letter-spacing: 0.5px;
    }
</style>

<div class="container mt-4">


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat cards row -->
    <div class="row mb-2">
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="stat-icon-circle" style="background: linear-gradient(135deg,#e3f0fb,#b8d8f5);">
                    <i class="fa-solid fa-user" style="color:#285072;"></i>
                </div>
                <div>
                    <div class="stat-value">@(ViewBag.Role ?? "User")</div>
                    <div class="stat-title">Your Role</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="stat-icon-circle" style="background: linear-gradient(135deg,#eafaf1,#b6f0cd);">
                    <i class="fa-solid fa-circle-check" style="color:#28a745;"></i>
                </div>
                <div>
                    <div class="stat-value" style="color:#28a745;">Active</div>
                    <div class="stat-title">Account Status</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-mini">
                <div class="stat-icon-circle" style="background: linear-gradient(135deg,#fff8e1,#ffe082);">
                    <i class="fa-solid fa-shield-halved" style="color:#f57c00;"></i>
                </div>
                <div>
                    <div class="stat-value" style="color:#f57c00;">Secure</div>
                    <div class="stat-title">Portal Status</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Welcome card -->
    <div class="dashboard-card">
        <span class="welcome-badge"><i class="fa-solid fa-star me-1"></i>Dashboard</span>
        <h2><i class="fa-solid fa-gauge me-2" style="color:#4C7190;"></i>Welcome, @Context.Session.GetString("Username")!</h2>
        <p style="color:#666; margin-bottom:24px;">You are logged in securely. Use the options below to get started.</p>
        <hr style="border-color:#eee; margin-bottom:24px;" />

        @if (ViewBag.Role == "Admin")
        {
            <a asp-action="UserList" class="btn btn-primary me-2">
                <i class="fa-solid fa-users me-2"></i>View User List
            </a>
            <a asp-area="Admin" asp-controller="Role" asp-action="Index" class="btn btn-primary">
                <i class="fa-solid fa-user-shield me-2"></i>Manage Roles
            </a>
        }
        else
        {
            <a asp-controller="Document" asp-action="Upload" class="btn btn-primary">
                <i class="fa-solid fa-cloud-arrow-up me-2"></i>Upload Document
            </a>
        }
    </div>

</div>
