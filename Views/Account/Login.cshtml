@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model SecureAuthPortal.ViewModels.LoginViewModel

<style>

    
    .login-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 20px;
    }
    
    .login-card {
        background: rgba(255,255,255,0.94);
        backdrop-filter: blur(8px);
        border: none;
        border-radius: 25px;
        box-shadow: 0px 20px 60px rgba(0,0,0,0.4);
        overflow: hidden;
        max-width: 450px;
        width: 100%;
        animation: fadeSlideUp 0.55s cubic-bezier(0.22,1,0.36,1) both;
    }

    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(32px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Password toggle */
    .password-wrapper {
        position: relative;
    }

    .password-wrapper .form-control {
        padding-right: 46px;
    }

    .toggle-eye {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #4C7190;
        font-size: 17px;
        background: none;
        border: none;
        padding: 0;
        line-height: 1;
        transition: color 0.2s;
        z-index: 5;
    }

    .toggle-eye:hover { color: #183B56; }
    
    .login-header {
        background: linear-gradient(
            135deg,
            #183B56,
            #285072,
            #4C7190
        );
        color: white;
        padding: 40px 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .login-header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(
            45deg,
            transparent,
            rgba(255,255,255,0.1),
            transparent
        );
        animation: shine 3s infinite;
    }
    
    @@keyframes shine {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    .login-header h2 {
        margin: 0;
        font-weight: 700;
        font-size: 32px;
        text-shadow: 0 2px 15px rgba(0,0,0,0.3);
        position: relative;
        z-index: 1;
    }
    
    .login-header p {
        margin: 10px 0 0 0;
        opacity: 0.95;
        font-size: 15px;
        position: relative;
        z-index: 1;
    }
    
    .login-body {
        padding: 35px 30px;
        background: rgba(255,255,255,0.98);
    }
    
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        font-size: 14px;
    }
    
    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px 15px;
        transition: all 0.3s;
        font-size: 15px;
        background: white;
    }
    
    .form-control:focus {
        border-color: #4C7190;
        box-shadow: 0px 0px 10px rgba(76,113,144,0.25);
        background: linear-gradient(to right, #ffffff, #f0f8ff);
    }
    
    .btn-login {
        background: linear-gradient(
            135deg,
            #183B56,
            #285072
        );
        border: none;
        border-radius: 12px;
        padding: 12px;
        font-weight: 600;
        color: white;
        width: 100%;
        transition: all 0.3s;
        font-size: 16px;
        box-shadow: 0 5px 20px rgba(24,59,86,0.35);
        position: relative;
        overflow: hidden;
    }
    
    .btn-login::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
        transition: left 0.5s;
    }
    
    .btn-login:hover::before {
        left: 100%;
    }
    
    .btn-login:hover {
        background: linear-gradient(
            135deg,
            #285072,
            #4C7190
        );
        transform: translateY(-2px);
        box-shadow: 0px 8px 20px rgba(24,59,86,0.35);
    }
    
    .register-link {
        text-align: center;
        margin-top: 20px;
        color: #333;
        font-size: 14px;
    }
    
    .register-link a {
        color: #285072;
        font-weight: 600;
        text-decoration: none;
        background: linear-gradient(135deg, #183B56, #4C7190);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .register-link a:hover {
        text-decoration: underline;
    }
    
    .forgot-password-link {
        color: #285072;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.3s;
        font-size: 13px;
    }
    
    .forgot-password-link:hover {
        text-decoration: underline;
        color: #183B56;
    }
    
    .alert {
        border-radius: 10px;
        font-size: 14px;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <h2><span id="loginTypewriter"></span></h2>
            <p>Login to access your account</p>
        </div>
        
        <div class="login-body">


            @if(ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Login" method="post">

                <div class="mb-4">
                    <label class="form-label">Username</label>
                    <input asp-for="Username"
                           class="form-control"
                           placeholder="Enter your username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Password</label>
                        <a asp-action="ForgotPassword" class="forgot-password-link">Forgot Password?</a>
                    </div>
                    <div class="password-wrapper">
                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password" />
                        <button type="button" class="toggle-eye" id="loginEyeBtn" onclick="toggleLoginPassword()" tabindex="-1">
                            <i class="fa-regular fa-eye" id="loginEyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                @* reCAPTCHA v3 token (invisible verification on submit) *@
                @{ ViewBag.RecaptchaFieldId = "g-recaptcha-response"; }
                <partial name="_RecaptchaV3Partial" />

                @* Submit button with reCAPTCHA handling *@
                <button type="submit" class="btn btn-login" id="loginBtn">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Login
                </button>

                <div class="register-link">
                    Don't have an account? <a asp-action="Register">Create one now</a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ===== TYPEWRITER EFFECT =====
        (function() {
            var text  = 'Welcome Back! \uD83D\uDD10';
            var el    = document.getElementById('loginTypewriter');
            var i     = 0;
            function type() {
                if (i < text.length) {
                    el.textContent += text.charAt(i++);
                    setTimeout(type, 60);
                }
            }
            setTimeout(type, 300);
        })();

        // Password visibility toggle
        function toggleLoginPassword() {
            var field = document.getElementById('loginPassword');
            var icon  = document.getElementById('loginEyeIcon');
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'fa-regular fa-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'fa-regular fa-eye';
            }
        }

        $(document).ready(function () {
            $("form").on("submit", function (e) {
                // If form is client-side invalid, let jQuery validation handle it
                if ($(this).valid && !$(this).valid()) {
                    return;
                }

                e.preventDefault();
                var form = this;

                // Show spinner on button
                var btn = document.getElementById('loginBtn');
                var originalBtnHtml = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Logging in...';
                btn.disabled = true;

                function resetLoginBtn() {
                    btn.innerHTML = originalBtnHtml;
                    btn.disabled = false;
                }

                executeRecaptchaV3('login', function (token) {
                    document.getElementById('g-recaptcha-response').value = token;
                    form.submit();
                }, function (message) {
                    resetLoginBtn();
                    alert(message);
                });
            });
        });
    </script>
}
