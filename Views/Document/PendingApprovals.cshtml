@model List<SecureAuthPortal.Models.DocumentMaster>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pending Document Approvals";
}

<style>
    .page-card {
        background: rgba(255,255,255,0.94);
        backdrop-filter: blur(8px);
        border: none;
        border-radius: 25px;
        box-shadow: 0px 20px 60px rgba(0,0,0,0.4);
        padding: 40px;
        margin-bottom: 24px;
    }

    .page-card h4 { color: #183B56; font-weight: 700; }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-approve {
        background: linear-gradient(135deg, #198754, #157347);
        border: none; border-radius: 8px; padding: 6px 16px;
        color: white; font-weight: 600; font-size: 13px;
        cursor: pointer; transition: all 0.25s;
    }
    .btn-approve:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(25,135,84,0.4); }

    .btn-reject {
        background: linear-gradient(135deg, #dc3545, #c82333);
        border: none; border-radius: 8px; padding: 6px 16px;
        color: white; font-weight: 600; font-size: 13px;
        cursor: pointer; transition: all 0.25s;
    }
    .btn-reject:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(220,53,69,0.4); }

    .empty-state {
        text-align: center; padding: 60px 20px; color: #888;
    }
    .empty-state i { font-size: 48px; color: #5da8e0; margin-bottom: 16px; display:block; }

    /* Action modal */
    #actionModal .modal-header-approve { background: linear-gradient(135deg,#198754,#157347); color:white; }
    #actionModal .modal-header-reject  { background: linear-gradient(135deg,#dc3545,#c82333); color:white; }
    #actionModal .modal-content { border-radius: 18px; overflow:hidden; }

    /* Spinner for inline button feedback */
    .btn-spinner { display:none; }
    .loading .btn-spinner { display:inline-block; }
    .loading .btn-text   { display:none; }
</style>

<div class="container mt-4">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="mb-0">🔍 Pending Document Approvals</h4>
            <span class="badge" style="background:linear-gradient(135deg,#183B56,#285072); font-size:15px; padding:8px 18px; border-radius:20px;">
                @Model.Count pending
            </span>
        </div>
        <hr />

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fa-solid fa-circle-check"></i>
                <h5>All Clear!</h5>
                <p>No documents are currently awaiting approval.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="pendingTable">
                    <thead style="background: linear-gradient(135deg, #183B56, #285072); color:white;">
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Document Type</th>
                            <th>File Name</th>
                            <th>Uploaded</th>
                            <th>Status</th>
                            <th style="min-width:180px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var doc in Model)
                        {
                            <tr id="row-@doc.DocumentId">
                                <td><strong>@i</strong></td>
                                <td>
                                    <strong>@(doc.User?.FullName ?? doc.User?.Username ?? "—")</strong>
                                    <br /><small class="text-muted">@doc.User?.EmailId</small>
                                </td>
                                <td>
                                    <span style="background:#e8f4fd; color:#285072; padding:3px 10px; border-radius:12px; font-size:12px; font-weight:600;">
                                        @doc.DocumentType
                                    </span>
                                </td>
                                <td>
                                    <a href="/Document/ReviewDocument/@doc.DocumentId" style="color:#285072; font-weight:500; text-decoration:none;">
                                        <i class="fa-solid fa-eye me-1 text-info"></i>@doc.FileName
                                    </a>
                                </td>
                                <td style="font-size:13px;">@doc.UploadDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <span class="status-badge" style="background:#fff3cd; color:#856404;">⏳ Pending</span>
                                </td>
                                <td>
                                     <button type="button" class="btn-approve me-1"
                                             onclick="handleAction('Approve', @doc.DocumentId, '@doc.FileName')">
                                         <i class="fa-solid fa-check me-1"></i>Approve
                                     </button>
                                     <button type="button" class="btn-reject"
                                             onclick="handleAction('Reject', @doc.DocumentId, '@doc.FileName')">
                                         <i class="fa-solid fa-xmark me-1"></i>Reject
                                     </button>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Modals {
    <!-- Custom Approve/Reject Modal -->
    <div id="customActionModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px);">
        <div style="background:white; border-radius:16px; overflow:hidden; width:100%; max-width:420px; box-shadow:0 20px 60px rgba(0,0,0,0.4); animation: fadeSlideUp 0.3s ease;">
            <div id="customActionHeader" style="padding:20px 24px; color:white;">
                <h5 id="customActionTitle" style="margin:0; font-weight:700;">Confirm Action</h5>
            </div>
            <div style="padding:24px;">
                <p id="customActionBody" style="margin:0 0 16px 0; color:#333; font-size:15px;"></p>
                <label style="font-weight:600; color:#183B56; display:block; margin-bottom:6px;">
                    Notes <small id="customActionNotesHint" class="text-muted"></small>
                </label>
                <textarea id="customActionNotes" class="form-control" rows="3" style="border-radius:10px; border:2px solid #e0e0e0; resize:none;" placeholder=""></textarea>
            </div>
            <div style="padding:0 24px 20px; display:flex; justify-content:flex-end; gap:10px;">
                <button onclick="closeCustomActionModal()" style="padding:8px 20px; border-radius:10px; border:1px solid #ccc; background:white; cursor:pointer; font-weight:500;">Cancel</button>
                <button id="customActionConfirmBtn" onclick="submitCustomAction()" style="padding:8px 20px; border-radius:10px; border:none; color:white; font-weight:600; cursor:pointer;">
                    <span id="customActionConfirmLabel">Confirm</span>
                </button>
            </div>
        </div>
    </div>
    <style>
        @@keyframes fadeSlideUp {
            from { opacity:0; transform:translateY(20px); }
            to   { opacity:1; transform:translateY(0); }
        }
    </style>
}

@Html.AntiForgeryToken()

@section Scripts {
<script>
    let _docId   = 0;
    let _action  = '';

    function handleAction(action, docId, fileName) {
        _docId = docId;
        _action = action;

        const modal  = document.getElementById('customActionModal');
        const header = document.getElementById('customActionHeader');
        const title  = document.getElementById('customActionTitle');
        const body   = document.getElementById('customActionBody');
        const notes  = document.getElementById('customActionNotes');
        const hint   = document.getElementById('customActionNotesHint');
        const btn    = document.getElementById('customActionConfirmBtn');
        const lbl    = document.getElementById('customActionConfirmLabel');

        notes.value = '';
        btn.disabled = false;

        if (action === 'Approve') {
            header.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
            title.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i>Approve Document';
            body.innerHTML = `Are you sure you want to approve <strong>${fileName}</strong>?<br><small class="text-muted">The user will be notified that their document is verified.</small>`;
            hint.textContent = '(optional — shown to user)';
            notes.placeholder = 'e.g. Document is clear and verified';
            btn.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
            lbl.textContent = 'Yes, Approve';
        } else {
            header.style.background = 'linear-gradient(135deg, #dc3545, #c82333)';
            title.innerHTML = '<i class="fa-solid fa-circle-xmark me-2"></i>Reject Document';
            body.innerHTML = `Are you sure you want to reject <strong>${fileName}</strong>?<br><small class="text-danger">Please provide a reason below.</small>`;
            hint.textContent = '(required — shown to user)';
            notes.placeholder = 'e.g. Please upload a clearer image of your document.';
            btn.style.background = 'linear-gradient(135deg, #dc3545, #c82333)';
            lbl.textContent = 'Yes, Reject';
        }

        modal.style.display = 'flex';
    }

    function closeCustomActionModal() {
        document.getElementById('customActionModal').style.display = 'none';
    }

    function submitCustomAction() {
        const notesValue = document.getElementById('customActionNotes').value.trim();
        if (_action === 'Reject' && notesValue === '') {
            alert('Please provide a reason for rejection.');
            return;
        }

        const btn = document.getElementById('customActionConfirmBtn');
        btn.disabled = true;
        document.getElementById('customActionConfirmLabel').textContent = 'Processing...';

        const url = _action === 'Approve'
            ? `/Document/Approve/${_docId}`
            : `/Document/Reject/${_docId}`;

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `notes=${encodeURIComponent(notesValue)}&__RequestVerificationToken=${encodeURIComponent(document.querySelector('input[name="__RequestVerificationToken"]').value)}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                closeCustomActionModal();
                // Animate row out
                const row = document.getElementById('row-' + _docId);
                if (row) {
                    row.style.transition = 'opacity 0.5s, transform 0.5s';
                    row.style.opacity    = '0';
                    row.style.transform  = 'translateX(30px)';
                    setTimeout(() => {
                        row.remove();
                        updateCount();
                    }, 500);
                }
            } else {
                alert('Error: ' + data.message);
                btn.disabled = false;
                document.getElementById('customActionConfirmLabel').textContent = _action === 'Approve' ? 'Yes, Approve' : 'Yes, Reject';
            }
        })
        .catch(err => {
            alert('Network error: ' + err);
            btn.disabled = false;
            document.getElementById('customActionConfirmLabel').textContent = _action === 'Approve' ? 'Yes, Approve' : 'Yes, Reject';
        });
    }

    function updateCount() {
        const rows = document.querySelectorAll('#pendingTable tbody tr');
        const badge = document.querySelector('.badge');
        if (rows.length === 0) {
            document.querySelector('.table-responsive').innerHTML = `
                <div class="empty-state text-center py-5">
                    <i class="fa-solid fa-circle-check" style="font-size:48px;color:#5da8e0;"></i>
                    <h5 class="mt-3">All Clear!</h5>
                    <p class="text-muted">No documents are currently awaiting approval.</p>
                </div>`;
        }
        if (badge) badge.textContent = rows.length + ' pending';
    }
</script>
}
