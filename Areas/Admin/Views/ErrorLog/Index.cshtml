@model List<SecureAuthPortal.Models.ErrorLog>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int curPage = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
}

<style>
    .log-header { background: linear-gradient(135deg, #6f1d1b, #b34700); color: white; border-radius: 18px; padding: 28px 32px; margin-bottom: 28px; }
    .log-header h2 { font-size: 26px; font-weight: 700; margin: 0; }
    .log-header p { margin: 4px 0 0; opacity: 0.85; font-size: 14px; }
    .filter-card { background: white; border-radius: 16px; padding: 20px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); margin-bottom: 20px; }
    .log-table { background: white; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .log-table thead th { background: linear-gradient(135deg, #6f1d1b, #b34700); color: white; border: none; font-weight: 600; padding: 14px 12px; font-size: 13px; }
    .log-table tbody tr:hover { background: rgba(220,53,69,0.04); }
    .log-table tbody td { border-color: #f1f3f5; padding: 11px 12px; font-size: 13px; vertical-align: middle; }
    .stack-toggle { cursor:pointer; color:#dc3545; font-size:12px; font-weight:600; text-decoration:underline; }
    .stack-trace { display:none; background:#1a1a2e; color:#e2e8f0; font-family:monospace; font-size:11px; padding:12px; border-radius:8px; white-space:pre-wrap; word-break:break-all; max-height:180px; overflow-y:auto; margin-top:6px; }
    .pagination-btn { padding:7px 14px; border-radius:8px; border:1px solid #dee2e6; background:white; cursor:pointer; font-size:13px; transition:all 0.2s; }
    .pagination-btn:hover, .pagination-btn.active { background:linear-gradient(135deg,#6f1d1b,#b34700); color:white; border-color:transparent; }
    .stat-card { border-radius:14px; padding:16px 20px; color:white; flex:1; min-width:130px; }
</style>

<div style="padding: 10px 0;">
    <!-- Header -->
    <div class="log-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2><i class="fa-solid fa-triangle-exclamation me-2"></i>Error Log</h2>
                <p>Automatically captured application exceptions and errors.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Export","ErrorLog",new{area="Admin",searchUsername=ViewBag.SearchUsername,searchController=ViewBag.SearchController,dateFrom=ViewBag.DateFrom,dateTo=ViewBag.DateTo})"
                   class="btn btn-sm btn-light fw-600" style="border-radius:10px; font-weight:600;">
                    <i class="fa-solid fa-file-csv me-1"></i>Export CSV
                </a>
                <form method="post" action="@Url.Action("Clear","ErrorLog",new{area="Admin"})" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger" style="border-radius:10px; font-weight:600;"
                            onclick="return confirm('Clear all error logs? This cannot be undone.')">
                        <i class="fa-solid fa-trash me-1"></i>Clear Logs
                    </button>
                </form>
            </div>
        </div>

        <!-- Stats -->
        <div class="d-flex gap-3 mt-4 flex-wrap">
            <div class="stat-card" style="background:rgba(255,255,255,0.15);">
                <div style="font-size:22px; font-weight:700;">@totalCount</div>
                <div style="font-size:12px; opacity:0.85;">Total Errors</div>
            </div>
            <div class="stat-card" style="background:rgba(255,255,255,0.1);">
                <div style="font-size:22px; font-weight:700;">@Model.Count</div>
                <div style="font-size:12px; opacity:0.85;">On This Page</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-card">
        <form method="get" action="@Url.Action("Index","ErrorLog",new{area="Admin"})">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-600 small mb-1">Username</label>
                    <input type="text" name="searchUsername" class="form-control form-control-sm" value="@ViewBag.SearchUsername" placeholder="Search username..." style="border-radius:8px;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-600 small mb-1">Controller</label>
                    <input type="text" name="searchController" class="form-control form-control-sm" value="@ViewBag.SearchController" placeholder="Search controller..." style="border-radius:8px;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-600 small mb-1">From Date</label>
                    <input type="date" name="dateFrom" class="form-control form-control-sm" value="@ViewBag.DateFrom" style="border-radius:8px;" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-600 small mb-1">To Date</label>
                    <input type="date" name="dateTo" class="form-control form-control-sm" value="@ViewBag.DateTo" style="border-radius:8px;" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px; padding:7px 20px; font-weight:600; background:linear-gradient(135deg,#6f1d1b,#b34700); border:none;">
                    <i class="fa-solid fa-magnifying-glass me-1"></i>Search
                </button>
                <a href="@Url.Action("Index","ErrorLog",new{area="Admin"})" class="btn btn-sm btn-secondary" style="border-radius:8px; padding:7px 16px;">
                    <i class="fa-solid fa-rotate-left me-1"></i>Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="log-table">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-check-circle" style="font-size:56px; color:#28a745; margin-bottom:16px;"></i>
                <h5 class="text-muted">No errors found!</h5>
                <p class="text-muted small">The application is running without any recorded exceptions.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table log-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th><i class="fa-solid fa-user me-1"></i>Username</th>
                            <th><i class="fa-solid fa-bug me-1"></i>Error Message</th>
                            <th><i class="fa-solid fa-code me-1"></i>Controller</th>
                            <th><i class="fa-solid fa-play me-1"></i>Action</th>
                            <th><i class="fa-solid fa-clock me-1"></i>Date & Time</th>
                            <th><i class="fa-solid fa-globe me-1"></i>IP</th>
                            <th><i class="fa-solid fa-terminal me-1"></i>Stack Trace</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted small">@log.Id</td>
                                <td><strong>@(log.Username ?? "Anonymous")</strong></td>
                                <td style="max-width:220px; color:#dc3545;">
                                    <i class="fa-solid fa-circle-exclamation me-1 text-danger"></i>
                                    <span title="@log.ErrorMessage">@(log.ErrorMessage?.Length > 60 ? log.ErrorMessage.Substring(0, 60) + "..." : log.ErrorMessage)</span>
                                </td>
                                <td><span class="badge bg-secondary">@log.Controller</span></td>
                                <td class="text-muted small">@log.Action</td>
                                <td class="text-muted small">@log.Timestamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                <td class="text-muted small font-monospace">@log.IpAddress</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.StackTrace))
                                    {
                                        <span class="stack-toggle" onclick="toggleStack('stack-@log.Id')">View Stack</span>
                                        <div id="stack-@log.Id" class="stack-trace">@log.StackTrace</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                <small class="text-muted">Showing <strong>@curPage</strong> of <strong>@totalPages</strong> — @totalCount total errors</small>
                <div class="d-flex gap-1">
                    @if (curPage > 1)
                    {
                        <a href="@Url.Action("Index","ErrorLog",new{area="Admin",page=curPage-1,searchUsername=ViewBag.SearchUsername,searchController=ViewBag.SearchController,dateFrom=ViewBag.DateFrom,dateTo=ViewBag.DateTo})" class="pagination-btn">‹ Prev</a>
                    }
                    @for (int i = Math.Max(1, curPage - 2); i <= Math.Min(totalPages, curPage + 2); i++)
                    {
                        <a href="@Url.Action("Index","ErrorLog",new{area="Admin",page=i,searchUsername=ViewBag.SearchUsername,searchController=ViewBag.SearchController,dateFrom=ViewBag.DateFrom,dateTo=ViewBag.DateTo})"
                           class="pagination-btn @(i == curPage ? "active" : "")">@i</a>
                    }
                    @if (curPage < totalPages)
                    {
                        <a href="@Url.Action("Index","ErrorLog",new{area="Admin",page=curPage+1,searchUsername=ViewBag.SearchUsername,searchController=ViewBag.SearchController,dateFrom=ViewBag.DateFrom,dateTo=ViewBag.DateTo})" class="pagination-btn">Next ›</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script>
    function toggleStack(id) {
        var el = document.getElementById(id);
        el.style.display = el.style.display === 'block' ? 'none' : 'block';
    }
</script>
